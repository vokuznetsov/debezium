# =============================================================================
#  Версии компонентов стенда.
#
#  Значения в этом файле — это то, что СОГЛАСОВАНО в контуре, а не то, что
#  оптимально. Рядом с каждой версией — с чем она конфликтует, что
#  рекомендуется вместо неё и почему. Сводная таблица — README.md, раздел 9.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL 17.9 — источник CDC.
#
# РИСК (не блокирующий): Debezium 2.6 официально тестировался до PostgreSQL 16.
# PG 17 появляется в матрице совместимости только у более новых сборок
# коннектора. Через pgoutput связка работает (проверено на этом стенде), но
# она непроверенная под нагрузкой — нужен нагрузочный тест на реальном объёме.
#
# PG 17 выбран не случайно и понижать его нельзя: параметр failover у
# pg_create_logical_replication_slot() и встроенный slotsync-воркер, на которых
# держится вся схема сохранения слота при переключении мастера, появились
# именно в 17. На PG 16 failover-слотов нет вообще.
# -----------------------------------------------------------------------------
POSTGRES_VERSION=17.9

# -----------------------------------------------------------------------------
# Confluent Platform 7.7.1 = Kafka 3.7.
#
# Debezium 2.6 собран против Kafka Connect 3.7.0, поэтому CP 7.7 — правильная
# линейка: и брокер, и воркер Connect, и Schema Registry берутся из неё.
#
# ОТКРЫТЫЙ ВОПРОС: в согласованном списке Schema Registry указан как "v1.17.1".
# Такой версии в версионировании Confluent Schema Registry не существует (там
# 7.x, синхронно с CP). Скорее всего это другой продукт (Apicurio Registry или
# Karapace) или внутренняя сборка. До выяснения на стенде стоит CP 7.7.1.
# Если в контуре реально Apicurio/Karapace — меняются URL и, возможно,
# subject naming strategy, это переделка конфига коннектора.
# -----------------------------------------------------------------------------
CONFLUENT_VERSION=7.7.1

# -----------------------------------------------------------------------------
# Debezium PostgreSQL Connector 2.6.1.Final.
#
# РЕКОМЕНДУЕТСЯ 2.6.2.Final. В 2.6.2 починен race condition при флаше offset
# в PostgreSQL: подтверждённый LSN в слоте расходился с состоянием топиков,
# что при рестарте коннектора давало ПОТЕРЮ СОБЫТИЙ. Для нашей задачи
# (последовательное применение в MS SQL по LSN) потеря событий = расхождение
# приёмника, которое обнаружится не сразу. Там же починена совместимость Avro.
#
# Апгрейд 2.6.1 -> 2.6.2 в пределах минорной ветки: конфиг коннектора не
# меняется, слот и публикация сохраняются, достаточно заменить плагин и
# перезапустить воркер.
# -----------------------------------------------------------------------------
DEBEZIUM_VERSION=2.6.1.Final

# -----------------------------------------------------------------------------
# io.confluent:kafka-connect-avro-converter — берётся из образа
# confluentinc/cp-kafka-connect:${CONFLUENT_VERSION}, то есть 7.7.1.
#
# БЛОКИРУЮЩЕЕ РАСХОЖДЕНИЕ С СОГЛАСОВАННЫМ СПИСКОМ: там указаны 6.0.2 / 6.1.2.
# Это линейка Kafka 2.6 / 2.7. С Kafka 3.7 она несовместима: converter
# тянет за собой kafka-clients и common-config своей линейки, воркер либо не
# поднимает коннектор (NoSuchMethodError / NoClassDefFoundError на старте
# задачи), либо падает при первой сериализации. Обойти конфигом нельзя.
# Версия converter'а обязана совпадать с линейкой CP.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# MS SQL — приёмник (Б). В части 1 НЕ используется, поднимается только чтобы
# стенд был полным и часть 2 было куда писать.
#
# Образ mcr.microsoft.com/mssql/server:2022-latest существует ТОЛЬКО под
# linux/amd64. На arm64-хосте (Apple Silicon) он идёт через эмуляцию: старт
# ~1-2 минуты, ест ~2 ГБ RAM. Поэтому он вынесен в compose-профиль sink и
# `make up` его НЕ поднимает. Поднять отдельно: `make up-sink`.
# -----------------------------------------------------------------------------
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_SA_PASSWORD=Str0ng!Passw0rd
MSSQL_PORT=1433

# -----------------------------------------------------------------------------
# Kafka UI — kafbat, а не provectus: provectus/kafka-ui заархивирован
# (последний релиз 0.7.2, разработка остановлена). kafbat/kafka-ui — форк,
# который её продолжает, и он multi-arch.
# -----------------------------------------------------------------------------
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:latest
KAFKA_UI_PORT=8080

# -----------------------------------------------------------------------------
# kcat 1.7.1 — только для проверок, профиль tools.
# Образ edenhill/kcat:1.7.1 тоже amd64-only, на arm64 идёт через эмуляцию.
# Скрипты проверок предпочитают kcat С ХОСТА (он должен быть собран с
# поддержкой avro/Schema Registry), а контейнер — фолбэк. См. scripts/lib.sh.
# -----------------------------------------------------------------------------
KCAT_IMAGE=edenhill/kcat:1.7.1

# =============================================================================
#  PostgreSQL: кластер 1 master + 2 реплики
# =============================================================================
POSTGRES_DB=cdc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Роль физической репликации (её создаёт sql/01-roles.sql)
REPL_USER=replicator
REPL_PASSWORD=replicator

# Роль Debezium. Права: LOGIN + REPLICATION + SELECT + USAGE.
# Прав CREATE на базу и суперюзера у неё НЕТ — это осознанно: в контуре
# Debezium не может создавать ни слоты, ни публикации, и стенд должен ловить
# ошибки прав так же, как прод. См. sql/01-roles.sql.
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium

PG_MASTER_PORT=55432
PG_REPLICA1_PORT=55433
PG_REPLICA2_PORT=55434

# Имена физических слотов реплик. Должны совпадать со списком в
# synchronized_standby_slots в pg/master/postgresql.conf — если не совпадут,
# логический слот перестанет придерживаться реплик и failover-слот потеряет
# смысл (реплика может отстать от подписчика).
REPLICA1_SLOT=replica_1_slot
REPLICA2_SLOT=replica_2_slot

# =============================================================================
#  CDC: слот, публикация, топик
# =============================================================================
# -----------------------------------------------------------------------------
#  СОСТАВ CDC: список схем через запятую. ЕДИНАЯ ТОЧКА ПРАВКИ.
#
#  Отсюда значение попадает сразу в три места, и они обязаны совпадать:
#    1) sql/04-publication.sql — какие таблицы добавить в публикацию
#    2) sql/02-schemas.sql     — кому выдать USAGE/SELECT роли debezium
#    3) connector/*.jsonc      — schema.include.list коннектора
#
#  Добавляете свою схему — правите ТОЛЬКО эту строку, дальше
#  `make up && make connector`. Процедура целиком — START-HERE.md, раздел 8.
#
#  Схема internal сюда СОЗНАТЕЛЬНО не входит: она нужна как трафик вне CDC,
#  на котором видно, зачем нужен heartbeat.
# -----------------------------------------------------------------------------
CDC_SCHEMAS=ref,catalog,sales

CDC_SLOT=dbz_cdc_slot
CDC_PUBLICATION=dbz_cdc_pub
CDC_TOPIC=cdc.events
CONNECTOR_NAME=pg-cdc
# Логический префикс топиков Debezium (topic.prefix). Ровно один сегмент без
# точек — на этом держится регексп роутера, см. connector/*.json.
TOPIC_PREFIX=dbz

# Профиль full (только для замера объёма, см. README раздел 5): свой префикс,
# свой слот, свой топик — чтобы два коннектора не смешивали потоки и
# метаданные транзакций. Топики префикса dbzf создаёт scripts/benchmark.sh.
TOPIC_PREFIX_FULL=dbzf
CDC_SLOT_FULL=dbz_cdc_slot_full
CDC_TOPIC_FULL=cdc.events.full

# =============================================================================
#  Kafka
# =============================================================================
# Фиксированный Cluster ID для KRaft. Менять нельзя: том kafka_data хранит
# meta.properties с этим id, при несовпадении брокер не стартует
# ("Cluster ID doesn't match"). Именно поэтому id лежит в .env, а не
# генерируется на старте — иначе том не переживёт пересоздание контейнера.
KAFKA_CLUSTER_ID=MkU3OEVGN0E5N0Y0NEJBQg
KAFKA_INTERNAL=kafka:9092
KAFKA_EXTERNAL_PORT=29092
# Bootstrap для скриптов, запускаемых С ХОСТА (вне docker).
KAFKA_BOOTSTRAP_HOST=localhost:29092
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_HOST_URL=http://localhost:8081
CONNECT_PORT=8083
CONNECT_HOST_URL=http://localhost:8083
# Внутренние URL (для контейнеров и для конфига коннектора)
SCHEMA_REGISTRY_INTERNAL_URL=http://schema-registry:8081

# =============================================================================
#  Гарантии порядка на producer'е Kafka
# =============================================================================
# max.in.flight.requests.per.connection для producer'а коннектора.
#
# ЭТО ЗНАЧЕНИЕ ИМЕЕТ СМЫСЛ ТОЛЬКО В ПАРЕ С enable.idempotence=true.
# Kafka валидирует связку на старте и не запускает producer при
# enable.idempotence=true и max.in.flight > 5. Между 1 и 5 разницы в
# гарантиях порядка нет — есть только разница в пропускной способности.
# Если кто-то уберёт enable.idempotence, оставив 5, порядок сломается ТИХО.
# verify-infra.sh проверяет связку по фактическому конфигу коннектора.
MAX_IN_FLIGHT=5

# Батчинг и компрессия producer'а. linger.ms подобран замером,
# см. README.md раздел 5.
PRODUCER_COMPRESSION=zstd
PRODUCER_LINGER_MS=50
PRODUCER_BATCH_SIZE=262144

# =============================================================================
#  Прочее
# =============================================================================
# Heartbeat Debezium. Обязателен: если по отслеживаемым таблицам затишье, а в
# базе идёт другой трафик, подтверждённый LSN слота не двигается и WAL растёт
# до исчерпания диска.
HEARTBEAT_INTERVAL_MS=10000
COMPOSE_PROJECT_NAME=dbzcdc
