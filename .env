# =============================================================================
#  Как этот файл попадает в docker compose
#
#  Автоматически — если команда запущена из каталога проекта:
#      cd /path/to/debezium && docker compose up -d
#  Из другого каталога нужны оба пути:
#      docker compose --env-file /path/to/debezium/.env -f /path/to/debezium/docker-compose.yml up -d
#  Разово переопределить значение (переменная окружения приоритетнее файла):
#      PG_MASTER_PORT=55555 docker compose up -d
#
#  Значения отсюда подставляются в docker-compose.yml (${ИМЯ}) — и только туда.
#  Проверить, что получилось: docker compose config
# =============================================================================

# --- версии ---
POSTGRES_VERSION=17.9
CONFLUENT_VERSION=7.7.1
DEBEZIUM_VERSION=2.6.1.Final
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# --- PostgreSQL ---
POSTGRES_DB=cdc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Роль физической репликации, под которой работают реплики. И имя, и пароль
# должны совпадать с init/01-init.sql, где эта роль создаётся.
REPL_USER=replicator
REPL_PASSWORD=replicator

# Роли debezium здесь нет: её пароль задан в init/01-init.sql и продублирован
# в connector/pg-cdc.json (конфиг коннектора читает Kafka Connect, а не
# compose, и подстановки ${...} в нём не работают). Меняете — меняйте в обоих.

# --- порты на хосте ---
PG_MASTER_PORT=55432
PG_REPLICA1_PORT=55433
PG_REPLICA2_PORT=55434
KAFKA_PORT=29092
SCHEMA_REGISTRY_PORT=8081
CONNECT_PORT=8083
# 8080 обычно чем-нибудь занят, поэтому UI на 8088
KAFKA_UI_PORT=8088

# Фиксированный ID кластера KRaft: если генерировать его на старте,
# том kafka_data не переживёт пересоздание контейнера.
KAFKA_CLUSTER_ID=MkU3OEVGN0E5N0Y0NEJBQg

COMPOSE_PROJECT_NAME=dbzcdc
