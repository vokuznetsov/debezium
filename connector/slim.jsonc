// =============================================================================
//  Профиль slim — ОСНОВНОЙ.
//
//  Формат JSONC: JSON плюс построчные комментарии (// в начале строки).
//  scripts/create-connector.sh снимает такие строки, подставляет ${ПЕРЕМЕННЫЕ}
//  из .env и проверяет результат через jq перед POST. Комментарии здесь не
//  украшение: половина этих свойств по отдельности не имеет смысла, и это
//  должно быть видно тому, кто правит файл, а не только тому, кто читал README.
//
//  Инвариант №1 (порядок) и инвариант №2 (объём) не обсуждаются. Каждое
//  свойство ниже относится к одному из них.
// =============================================================================
{
  "name": "${CONNECTOR_NAME}",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",

    // -----------------------------------------------------------------------
    //  ИНВАРИАНТ №1: одна задача.
    //  tasks.max > 1 для PostgreSQL-коннектора всё равно даёт одну задачу
    //  (логический слот читается одним подписчиком), но объявлять больше —
    //  значит приглашать кого-то «оптимизировать» это позже.
    // -----------------------------------------------------------------------
    "tasks.max": "1",

    // --- подключение к БД (А): ТОЛЬКО МАСТЕР ---------------------------------
    //  С синхронизированного слота на реплике читать нельзя до промоушена,
    //  PostgreSQL это запрещает. Разгрузить CDC на реплику невозможно.
    "database.hostname": "pg-master",
    "database.port": "5432",
    "database.user": "${DEBEZIUM_USER}",
    "database.password": "${DEBEZIUM_PASSWORD}",
    "database.dbname": "${POSTGRES_DB}",

    // Логический префикс топиков. РОВНО ОДИН СЕГМЕНТ БЕЗ ТОЧЕК — от этого
    // зависит регексп роутера ниже.
    "topic.prefix": "${TOPIC_PREFIX}",

    // -----------------------------------------------------------------------
    //  СЛОТ И ПУБЛИКАЦИЯ — ТОЛЬКО ИСПОЛЬЗОВАТЬ, НЕ СОЗДАВАТЬ
    //
    //  Слот создан заранее devops'ом с failover => true (sql/03-slots.sql).
    //  Debezium 2.6 сам флаг failover не выставляет (DBZ-8412), поэтому если
    //  дать ему создать слот, слот получится БЕЗ failover — и это не будет
    //  видно нигде, кроме pg_replication_slots, до первого переключения
    //  мастера, когда CDC потребует полной пересинхронизации.
    //
    //  slot.drop.on.stop=false: удаление слота при остановке коннектора
    //  означает потерю позиции и, при snapshot.mode=no_data, безвозвратный
    //  разрыв в потоке.
    // -----------------------------------------------------------------------
    "plugin.name": "pgoutput",
    "slot.name": "${CDC_SLOT}",
    "slot.drop.on.stop": "false",
    "publication.name": "${CDC_PUBLICATION}",
    "publication.autocreate.mode": "disabled",

    // -----------------------------------------------------------------------
    //  SNAPSHOT
    //
    //  no_data — читает только структуру таблиц, данные не вычитывает.
    //  Базы (А) и (Б) синхронны на момент T, а initial snapshot 500 таблиц в
    //  ОДИН топик с ОДНОЙ партицией занял бы часы и не нужен.
    //
    //  no_data — новое имя бывшего schema_only в Debezium 2.6; never устарел.
    // -----------------------------------------------------------------------
    "snapshot.mode": "no_data",

    // -----------------------------------------------------------------------
    //  СОСТАВ CDC
    //
    //  Состав живёт в SQL (sql/04-publication.sql), а не здесь:
    //  table.include.list на 500 строк неуправляем. Коннектор фильтрует
    //  грубо — по схемам, и точечно исключает отдельные таблицы.
    // -----------------------------------------------------------------------
    "schema.include.list": "${CDC_SCHEMAS}",

    // Точечные исключения. Формат: schema.table через запятую.
    // sales.order_items_archive ЕСТЬ в публикации (она ведётся по схемам), в
    // неё пишутся строки и по ней идёт WAL — но событий в cdc.events нет.
    // Так выглядит рабочий механизм точечного исключения; verify-order.sh
    // показывает отсутствие этой таблицы в статистике.
    "table.exclude.list": "sales.order_items_archive",

    // ИНВАРИАНТ №2: исключение заведомо тяжёлых колонок.
    // spec_blob — bytea, в приёмнике не нужен. Механизм показан на одной
    // колонке; в контуре сюда уезжает список blob/больших текстовых полей.
    // ВАЖНО: column.exclude.list режет сообщение, но НЕ режет WAL — колонка
    // всё равно попадает в поток pgoutput и отбрасывается коннектором.
    // Чтобы не отдавать её и на стороне БД, нужна публикация со списком
    // колонок (PG 15+) — но её совместимость с Debezium 2.6 требует
    // отдельной проверки, см. README раздел 5.
    "column.exclude.list": "catalog.products.spec_blob",

    // -----------------------------------------------------------------------
    //  ЧТО СОЗНАТЕЛЬНО НЕ ОПТИМИЗИРУЕТСЯ
    //
    //  decimal.handling.mode = precise. Переключение на double уменьшило бы
    //  сообщения и МОЛЧА испортило денежные значения. Это банковские данные,
    //  здесь размен неприемлем. precise в Avro = bytes + logicalType decimal.
    //
    //  time.precision.mode НЕ ЗАДАН СОЗНАТЕЛЬНО — остаётся дефолтным.
    // -----------------------------------------------------------------------
    "decimal.handling.mode": "precise",

    // ИНВАРИАНТ №2: без tombstone'ов. Compaction на cdc.events выключен и
    // запрещён, значит tombstone'ы никому не нужны, а каждый DELETE давал бы
    // ВТОРОЕ сообщение.
    "tombstones.on.delete": "false",

    // txId и границы транзакций. Топик ${TOPIC_PREFIX}.transaction — 2
    // сегмента, под регексп роутера (3 сегмента) не попадает.
    "provide.transaction.metadata": "true",

    // ОБЯЗАТЕЛЕН. Если по отслеживаемым таблицам затишье, а в базе идёт другой
    // трафик (схема internal), подтверждённый LSN слота не двигается и WAL
    // растёт до исчерпания диска. Heartbeat двигает offset слота.
    "heartbeat.interval.ms": "${HEARTBEAT_INTERVAL_MS}",

    // =======================================================================
    //  ТРАНСФОРМАЦИИ
    //
    //  ПОРЯДОК ВАЖЕН: unwrap РАНЬШЕ reroute.
    //  reroute переписывает имя топика в cdc.events. Если он отработает
    //  первым, unwrap применится к записи, у которой имя топика уже не
    //  соответствует ни одной таблице — часть метаданных (__table, __schema)
    //  берётся из блока source и переживёт это, но полагаться на такой
    //  порядок нельзя, а отладка станет неприятной.
    // =======================================================================
    "transforms": "unwrap,reroute",

    // -----------------------------------------------------------------------
    //  ИНВАРИАНТ №2: плоский формат вместо полного конверта Debezium.
    //
    //  Вместо before + after + source (~12 полей) + ts_ms едет сама строка
    //  плюс 6 служебных полей. Блок source в полном конверте повторяет в
    //  КАЖДОМ сообщении поля, константные для всего коннектора: version,
    //  connector, name, db, sequence, snapshot.
    //
    //  Что теряется (честно, подробно в README раздел 5):
    //    - before-образ — для применения в MS SQL не нужен (UPDATE и DELETE
    //      идут по PK);
    //    - события truncate и message;
    //    - часть диагностики (какой именно коннектор/версия писали событие).
    //
    //  __lsn и __txId СОХРАНЯЮТСЯ — на них держатся порядок и
    //  идемпотентность consumer'а части 2. Их убирать ради экономии нельзя.
    // -----------------------------------------------------------------------
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.add.fields": "op,table,schema,lsn,txId,ts_ms",

    // rewrite: DELETE приезжает СТРОКОЙ с __deleted=true, а не пустым
    // значением. Consumer части 2 обрабатывает его как обычную запись.
    "transforms.unwrap.delete.handling.mode": "rewrite",

    // ИНВАРИАНТ №2, отдельно от tombstones.on.delete: иначе каждый DELETE
    // даёт два сообщения (событие + tombstone).
    "transforms.unwrap.drop.tombstones": "true",

    // -----------------------------------------------------------------------
    //  ИНВАРИАНТ №1: ВСЁ В ОДИН ТОПИК
    //
    //  Регексп с РОВНО ТРЕМЯ сегментами — чтобы под него не попали:
    //    ${TOPIC_PREFIX}.transaction        (2 сегмента)
    //    __debezium-heartbeat.${TOPIC_PREFIX} (2 сегмента, другой префикс)
    //  Если случайно переписать регексп на ^${TOPIC_PREFIX}\\..*, метаданные
    //  транзакций и heartbeat уедут в cdc.events и загадят поток.
    // -----------------------------------------------------------------------
    "transforms.reroute.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.reroute.regex": "^${TOPIC_PREFIX}\\.[^.]+\\.[^.]+$",
    "transforms.reroute.replacement": "${CDC_TOPIC}",

    // =======================================================================
    //  КОНВЕРТЕРЫ И SCHEMA REGISTRY
    // =======================================================================
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "${SCHEMA_REGISTRY_INTERNAL_URL}",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "${SCHEMA_REGISTRY_INTERNAL_URL}",

    // -----------------------------------------------------------------------
    //  ОБЯЗАТЕЛЬНО ИЗ-ЗА ЕДИНОГО ТОПИКА.
    //
    //  При дефолтной TopicNameStrategy subject считается по имени топика,
    //  то есть схемы ВСЕХ 500 таблиц попали бы в один subject
    //  cdc.events-value, и Schema Registry зарубил бы их по compatibility
    //  (backward) на ВТОРОЙ ЖЕ таблице.
    //
    //  TopicRecordNameStrategy: subject = cdc.events-<полное имя Avro-рекорда>,
    //  у каждой таблицы свой. Побочная польза: полное имя рекорда однозначно
    //  определяет исходную таблицу, что нужно consumer'у части 2.
    // -----------------------------------------------------------------------
    "key.converter.key.subject.name.strategy": "io.confluent.kafka.serializers.subject.TopicRecordNameStrategy",
    "value.converter.value.subject.name.strategy": "io.confluent.kafka.serializers.subject.TopicRecordNameStrategy",

    // -----------------------------------------------------------------------
    //  КЭШ СХЕМ — ИЗ-ЗА 500 ТАБЛИЦ.
    //  500 таблиц x (ключ + значение) ~ 1000 схем при дефолтном лимите
    //  max.schemas.per.subject = 1000. Ровно на границе начинаются плавающие
    //  ошибки под нагрузкой (кэш вытесняет схему, converter идёт в SR,
    //  получает throttling). Поднято с запасом.
    // -----------------------------------------------------------------------
    "key.converter.max.schemas.per.subject": "5000",
    "value.converter.max.schemas.per.subject": "5000",

    // На стенде true — схемы регистрируются сами по факту первого события.
    // В контуре это, скорее всего, false с предварительной регистрацией
    // контрактов (contracts/, scripts/export-contracts.sh): тогда неожидаемое
    // изменение структуры таблицы уронит коннектор, а не уедет в приёмник.
    "key.converter.auto.register.schemas": "true",
    "value.converter.auto.register.schemas": "true",

    // =======================================================================
    //  PRODUCER: ИНВАРИАНТ №1 (ПОРЯДОК)
    //
    //  producer.override.* работает ТОЛЬКО при
    //  connector.client.config.override.policy=All на воркере Connect
    //  (см. docker-compose.yml, сервис connect). Без политики Connect МОЛЧА
    //  проигнорирует всё, что ниже, и возьмёт настройки воркера. Конфиг будет
    //  выглядеть правильным, а гарантии не будет. verify-infra.sh проверяет,
    //  что override реально действует.
    // =======================================================================

    // -----------------------------------------------------------------------
    //  !!! ЭТИ ДВЕ СТРОКИ СВЯЗАНЫ И ПО ОТДЕЛЬНОСТИ НЕ ИМЕЮТ СМЫСЛА !!!
    //
    //  Без идемпотентности несколько батчей «в полёте» ломают порядок:
    //  батч 1 (INSERT) упал по таймауту, батч 2 (UPDATE) записался, ретрай
    //  батча 1 лёг ПОСЛЕ него — в логе UPDATE раньше INSERT.
    //
    //  С enable.idempotence=true producer нумерует батчи монотонной
    //  последовательностью по партиции, брокер сверяет номер каждого
    //  входящего батча с последним принятым и ОТВЕРГАЕТ пришедший не по
    //  порядку (OutOfOrderSequenceException). Батч 2 физически не попадёт в
    //  лог, пока не записан батч 1; producer перестраивает очередь и
    //  ретраит с правильного места.
    //
    //  Граница 5 — не компромисс, а спроектированный предел: брокер держит
    //  буфер ровно на пять неподтверждённых батчей на партицию. Kafka
    //  валидирует связку на старте и НЕ ЗАПУСКАЕТ producer при
    //  enable.idempotence=true и max.in.flight > 5. Между 1 и 5 разницы в
    //  гарантиях порядка нет, есть разница в пропускной способности.
    //
    //  НИКОГДА не отключать enable.idempotence, не понизив одновременно
    //  max.in.flight до 1. Порознь они порядка не дают, а отказ происходит
    //  ТИХО — без ошибок и алертов, до момента, когда consumer части 2
    //  упрётся в foreign key.
    // -----------------------------------------------------------------------
    "producer.override.enable.idempotence": "true",
    "producer.override.max.in.flight.requests.per.connection": "${MAX_IN_FLIGHT}",

    // acks=all — третий участник связки: с acks=1 подтверждённая запись
    // может быть потеряна при смене лидера, и тогда монотонность LSN в
    // топике нарушится провалом, а не перестановкой.
    "producer.override.acks": "all",

    // -----------------------------------------------------------------------
    //  ИНВАРИАНТ №2: компрессия и батчинг.
    //  CDC-поток — однотипные структуры с повторяющимися именами полей,
    //  жмётся в разы. Без linger.ms батчи мелкие и компрессия работает
    //  вполсилы: zstd жмёт БАТЧ, а не сообщение.
    //  Значение linger.ms подобрано замером, см. README раздел 5.
    // -----------------------------------------------------------------------
    "producer.override.compression.type": "${PRODUCER_COMPRESSION}",
    "producer.override.linger.ms": "${PRODUCER_LINGER_MS}",
    "producer.override.batch.size": "${PRODUCER_BATCH_SIZE}"

    // ЗДЕСЬ НЕТ И НЕ ДОЛЖНО БЫТЬ НИ ОДНОГО СВОЙСТВА topic.creation.*
    // Топики создаются заранее (kafka-init), auto-create выключен на брокере
    // и на воркере. verify-infra.sh падает, если такое свойство появится.
  }
}
