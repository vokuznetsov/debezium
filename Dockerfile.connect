# Kafka Connect (Confluent Platform) + плагин Debezium PostgreSQL.
# Плагин ставится готовым артефактом с Maven Central.
#
# avro-converter берётся из этого же образа (/usr/share/java/kafka-serde-tools),
# то есть той же линейки, что брокер и Schema Registry.
ARG CONFLUENT_VERSION=7.7.1
FROM confluentinc/cp-kafka-connect:${CONFLUENT_VERSION}

ARG DEBEZIUM_VERSION=2.6.1.Final

USER root
RUN set -eux; \
    mkdir -p /usr/share/confluent-hub-components; \
    curl -fsSL \
      "https://repo1.maven.org/maven2/io/debezium/debezium-connector-postgres/${DEBEZIUM_VERSION}/debezium-connector-postgres-${DEBEZIUM_VERSION}-plugin.tar.gz" \
      -o /tmp/dbz.tar.gz; \
    tar -xzf /tmp/dbz.tar.gz -C /usr/share/confluent-hub-components; \
    rm -f /tmp/dbz.tar.gz; \
    chown -R appuser:appuser /usr/share/confluent-hub-components
USER appuser
